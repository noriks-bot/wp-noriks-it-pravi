#. Plugin Name of the plugin
#: clone-duplicate-orders-for-woocommerce.php
#: includes/class-cdo-wc-cloner.php:391
msgid "Clone / Duplicate Orders for WooCommerce"
msgstr "Clone / Duplicate Orders for WooCommerce"

#. Description of the plugin
#: clone-duplicate-orders-for-woocommerce.php
msgid "Clone, duplicate or copy WooCommerce orders in one-click. HPOS compatible."
msgstr "Клонируйте, дублируйте или копируйте заказы WooCommerce в один клик. Совместимо с HPOS."

#. Author of the plugin
#: clone-duplicate-orders-for-woocommerce.php
msgid "YMMV LLC"
msgstr "YMMV LLC"

#. Author URI of the plugin
#: clone-duplicate-orders-for-woocommerce.php
msgid "https://www.ymmv.co"
msgstr "https://www.ymmv.co"

#: includes/class-cdo-wc-cloner.php:105
#: includes/class-cdo-wc-cloner.php:142
msgid "Clone Order"
msgstr "Клонировать заказ"

#: includes/class-cdo-wc-cloner.php:109
msgid "Clone is not available for this order."
msgstr "Клонирование недоступно для этого заказа."

#: includes/class-cdo-wc-cloner.php:128
msgid "Clone order"
msgstr "Клонировать заказ"

#: includes/class-cdo-wc-cloner.php:159
msgid "This order is already being cloned, and we have detected multiple clicks. You will be redirected to the orders page shortly."
msgstr "Этот заказ уже клонируется, и мы обнаружили несколько нажатий. Вы будете перенаправлены на страницу заказов в ближайшее время."

#. translators: %1$ is number of seconds. %2$ is the word here that links to orders index.
#: includes/class-cdo-wc-cloner.php:161
msgid "If you are not redirected within %1$d seconds, click %2$s."
msgstr "Если вы не будете перенаправлены в течение %1$d секунд, нажмите %2$s."

#. translators: %1$ is number of seconds. %2$ is the word here that links to orders index.
#: includes/class-cdo-wc-cloner.php:161
msgid "here"
msgstr "здесь"

#. translators: %s: New order URL, %d: New order ID
#: includes/class-cdo-wc-cloner.php:190
#: includes/class-cdo-wc-cloner.php:221
msgid "Order successfully duplicated. New order ID: <a href=\"%1$s\">#%2$d</a>"
msgstr "Заказ успешно дублирован. Новый ID заказа: <a href=\"%1$s\">#%2$d</a>"

#: includes/class-cdo-wc-cloner.php:203
msgid "Nonce verification failed or order ID not set."
msgstr "Ошибка проверки Nonce или ID заказа не установлен."

#: includes/class-cdo-wc-cloner.php:373
msgid "HPOS Status"
msgstr "Статус HPOS"

#. translators: %1$ %2$ wraps a link to the settings page
#: includes/class-cdo-wc-init.php:80
msgid "Thanks for activating Clone / Duplicate Orders for WooCommerce."
msgstr "Спасибо за активацию Clone / Duplicate Orders for WooCommerce."

#. translators: %1$s is the opening <a> tag with a link to activate WooCommerce, and %2$s is the closing </a> tag.
#: includes/class-cdo-wc-init.php:115
msgid "Clone / Duplicate Orders for WooCommerce requires WooCommerce to be active. Please %1$s Activate WooCommerce %2$s."
msgstr "Clone / Duplicate Orders for WooCommerce требует активного WooCommerce. Пожалуйста, %1$s Активируйте WooCommerce %2$s."

#. translators: %1$s is the opening <a> tag with a link to install WooCommerce, and %2$s is the closing </a> tag.
#: includes/class-cdo-wc-init.php:127
msgid "Clone / Duplicate Orders for WooCommerce requires WooCommerce to be installed and active. Please %1$s Install WooCommerce%2$s."
msgstr "Clone / Duplicate Orders for WooCommerce требует установки и активации WooCommerce. Пожалуйста, %1$s Установите WooCommerce%2$s."
